{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(nix eval *)",
      "Bash(nix flake check *)",
      "Bash(nix flake show *)",
      "Bash(nix flake metadata *)",
      "Bash(nix search *)",
      "Bash(nix path-info *)",
      "Bash(nix why-depends *)",
      "Bash(nix-store -q *)",
      "Bash(nixfmt --check *)",
      "Bash(git-crypt status *)",
      "Read(//nix/store/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/nix-post-edit.sh"
          }
        ]
      }
    ]
  }
}
