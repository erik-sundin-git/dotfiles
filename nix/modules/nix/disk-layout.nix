{ inputs, ... }:
let
  # The one partition layout install-host creates: GPT with an ESP (UEFI) or a
  # bios_grub partition (BIOS), swap sized for hibernate, ext4 root. Hosts
  # generated by install-host import nixos.diskLayout; for reinstalling a host
  # with a hand-written hardware.nix, install-host runs disko on
  # `lib.diskLayout` directly and patches the new UUIDs into that file.
  diskLayout =
    {
      device,
      swapGiB,
      efi,
    }:
    {
      disk.main = {
        type = "disk";
        inherit device;
        content = {
          type = "gpt";
          partitions =
            (
              if efi then
                {
                  ESP = {
                    size = "512M";
                    type = "EF00";
                    content = {
                      type = "filesystem";
                      format = "vfat";
                      mountpoint = "/boot";
                      mountOptions = [ "umask=0077" ];
                    };
                  };
                }
              else
                {
                  # disko points boot.loader.grub.devices at the disk
                  boot = {
                    size = "1M";
                    type = "EF02";
                  };
                }
            )
            // {
              swap = {
                size = "${toString swapGiB}G";
                content = {
                  type = "swap";
                  resumeDevice = true;
                };
              };
              root = {
                size = "100%";
                content = {
                  type = "filesystem";
                  format = "ext4";
                  mountpoint = "/";
                };
              };
            };
        };
      };
    };
in
{
  flake.lib = { inherit diskLayout; };

  flake.modules.nixos.diskLayout =
    { config, lib, ... }:
    let
      cfg = config.diskLayout;
    in
    {
      imports = [ inputs.disko.nixosModules.disko ];

      options.diskLayout = {
        device = lib.mkOption {
          type = lib.types.str;
          description = "The whole disk, preferably a /dev/disk/by-id path.";
        };
        swapGiB = lib.mkOption { type = lib.types.ints.positive; };
      };

      config = {
        disko.devices = diskLayout {
          inherit (cfg) device swapGiB;
          efi = config.commonConfig.bootEFI;
        };
        boot.loader.grub.enable = lib.mkIf (!config.commonConfig.bootEFI) true;
      };
    };
}
