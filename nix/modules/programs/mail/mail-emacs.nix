{ ... }:
{
  flake.modules.homeManager.mail =
    { config, ... }:
    let
      acct = config.accounts.email.accounts.proton;
    in
    {
      # notmuch.el from nixpkgs (pinned), not MELPA; post-init.el loads it with
      # :ensure nil. Delete any ~/.emacs.d/var/elpa/notmuch-* copy, which would
      # shadow it.
      programs.emacs.extraPackages = epkgs: [ epkgs.notmuch ];

      # Read by the Email section of post-init.el. no-byte-compile: compile-angel
      # would otherwise leave a .elc that beats this file (store mtimes are 1970).
      home.file.".emacs.d/nix-mail.el".text = ''
        ;; -*- no-byte-compile: t; lexical-binding: t -*-
        ;; Generated by nix, see programs/mail/mail-emacs.nix.
        (setq notmuch-command "${config.programs.notmuch.package}/bin/notmuch"
              sendmail-program "${config.programs.msmtp.package}/bin/msmtp"
              user-mail-address "${acct.address}"
              user-full-name "${acct.realName}")
      '';
    };
}
