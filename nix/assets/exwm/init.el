;;; init.el --- EXWM session entry point -*- no-byte-compile: t; lexical-binding: t; -*-

;; Loaded by exwm-session (programs/exwm/exwm.nix) with `emacs -l', after
;; the regular init in ~/.emacs.d, which stays unaware of EXWM.  Nothing here
;; is loaded outside the EXWM session.
;;
;; my-exwm-nix.el is generated by nix (binds from swayBindingsData, window
;; rules, bar data); my-exwm.el and my-exwm-bar.el turn that data into the
;; window manager.

;;; Code:

(defvar my-exwm-directory
  (file-name-directory (or load-file-name buffer-file-name))
  "Directory holding the EXWM elisp.
exwm-session sets it to ~/.emacs.d/exwm/ before loading this file:
`load-file-name' is the resolved store path of this symlink, and the
generated my-exwm-nix.el lives in a different store path.  The fallback
serves running the files from one plain directory (testing).  Not
`user-emacs-directory', which points to var/.")

(defun my-exwm-load-files ()
  "Load the EXWM config files by their full .el names.
`load-prefer-newer' sees the 1970 store mtimes through the home-manager
symlinks, so a stray .elc must never be considered."
  (dolist (file '("my-exwm-nix.el" "my-exwm.el" "my-exwm-bar.el"))
    (load (expand-file-name file my-exwm-directory) nil 'nomessage 'nosuffix)))

;; easysession: this Emacs keeps its own session.  The workspace frames
;; belong to EXWM, so no frames are restored (restoring could delete or
;; reuse them) and they never end up in the regular "main" session.
(defvar easysession-enable-frameset-restore)
(defvar easysession-setup-load-predicate)
(with-eval-after-load 'easysession
  (setq easysession-enable-frameset-restore nil
        easysession-setup-load-predicate #'ignore))

(defun my-exwm--switch-session ()
  "Switch to the \"exwm\" easysession session, if easysession is installed."
  (when (fboundp 'easysession-switch-to)
    (easysession-switch-to "exwm")))

;; After easysession's own startup hooks (depth 102/103)
(add-hook 'emacs-startup-hook #'my-exwm--switch-session 105)

(condition-case err
    (progn
      (require 'exwm)
      (require 'exwm-randr)
      (require 'exwm-systemtray)
      (my-exwm-load-files)
      ;; This Emacs is the server: services.emacs doesn't autostart under
      ;; EXWM, so emacsclient reaches the window manager's Emacs.
      (require 'server)
      (unless (server-running-p)
        (server-start))
      (exwm-randr-mode 1)
      (exwm-systemtray-mode 1)
      (exwm-wm-mode 1))
  (error
   ;; Leave a readable error instead of a bare frame with no window manager
   (with-current-buffer (get-buffer-create "*exwm-init-error*")
     (insert (format "EXWM failed to start: %s\n" (error-message-string err))))
   (pop-to-buffer "*exwm-init-error*")))

;;; init.el ends here
